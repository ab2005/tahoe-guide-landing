{
  "buildCommand": "echo static",
  "installCommand": "echo none",
  "outputDirectory": ".",
  "redirects": [
    {
      "source": "/ru",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/ru/",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/ru/index.html",
      "destination": "/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/hosts",
      "destination": "/hosts.html"
    }
  ]
}
